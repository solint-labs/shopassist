# ── General ───────────────────────────────────────────────────────────────────
ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false
DATABASE_URL=sqlite+aiosqlite:///./shopassist.db
TENANT_CONFIG_PATH=config/tenants/brewline.yaml

# ── LLM ───────────────────────────────────────────────────────────────────────
# Anthropic:
#   LLM_PROVIDER=anthropic   LLM_MODEL=claude-haiku-5-5   LLM_API_KEY=sk-ant-...
# Any OpenAI-compatible API (OpenAI, Azure, Together, Groq...):
#   LLM_PROVIDER=openai      LLM_MODEL=<model name>       LLM_API_KEY=...
# Self-hosted open-weights model via Ollama or vLLM:
#   LLM_PROVIDER=openai      LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=<model tag>
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# ── Meta platform ─────────────────────────────────────────────────────────────
META_APP_SECRET=
META_VERIFY_TOKEN=choose-a-long-random-string
META_GRAPH_VERSION=v27.0

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

PAGE_ID=
PAGE_ACCESS_TOKEN=

INSTAGRAM_ACCOUNT_ID=
# For "Instagram API with Instagram Login" instead of Facebook Login:
# INSTAGRAM_API_HOST=https://graph.instagram.com
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_MESSAGING_NODE=<your IG professional account id>

# Log outbound messages instead of sending them (local testing)
DRY_RUN_OUTBOUND=true

# ── RAG (Part 2) ──────────────────────────────────────────────────────────────
# Qdrant server (prod) or embedded on-disk mode (single node / dev)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
KNOWLEDGE_DIR=knowledge/brewline
RAG_ENCODERS=fastembed            # fastembed (open-source models on CPU) | hashing (offline tests)
RAG_DENSE_MODEL=BAAI/bge-small-en-v1.5
RAG_SPARSE_MODEL=Qdrant/bm25
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_MIN_SCORE=0.3
RAG_INGEST_ON_STARTUP=true

# ── Shopify (Part 2) ──────────────────────────────────────────────────────────
SHOPIFY_SHOP=your-store             # your-store.myshopify.com
SHOPIFY_API_VERSION=2026-10
# Option A: Dev Dashboard app (client credentials grant, token auto-refreshed every ~24h)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Option B: legacy custom app created in the Shopify admin before 2026-01-01
SHOPIFY_ACCESS_TOKEN=
