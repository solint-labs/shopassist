# Production environment template. Copy to .env on the server (Docker Compose) or load it into
# your secret manager (Kubernetes). Values marked CHANGE_ME must be set; example.com values are
# placeholders until the deployment is hosted.
#   make keys      # generates PII keys, admin bootstrap key, verify token

ENV=prod
LOG_LEVEL=INFO
LOG_JSON=true
PUBLIC_BASE_URL=https://shopassist.example.com
SHOPASSIST_DOMAIN=shopassist.example.com
ACME_EMAIL=ops@example.com
POSTGRES_PASSWORD=CHANGE_ME

# Multi-tenant layout (one YAML per store, knowledge/<tenant_id>/*.md)
TENANTS_DIR=config/tenants
KNOWLEDGE_ROOT=knowledge
RAG_ENCODERS=fastembed
RAG_INGEST_ON_STARTUP=true

# LLM: primary + fallbacks (different vendor and/or self-hosted)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_API_KEY=CHANGE_ME
LLM_FALLBACKS=[]

# Meta app (one app, all channels)
META_APP_ID=CHANGE_ME
META_APP_SECRET=CHANGE_ME
META_VERIFY_TOKEN=CHANGE_ME
META_GRAPH_VERSION=v27.0
META_HANDOVER=true
DRY_RUN_OUTBOUND=false
# Single-store mode only (multi-tenant stores declare these in their YAML via env:/file: refs)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
PAGE_ID=
PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Shopify (single-store mode; multi-tenant: per-tenant `shopify:` block)
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=

# Privacy
PII_ENCRYPTION_KEYS=CHANGE_ME
PII_BLIND_INDEX_KEY=CHANGE_ME
RETENTION_DAYS_MESSAGES=90
RETENTION_DAYS_PII=30

# Escalation
HELPDESK=none
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# Operators
ADMIN_BOOTSTRAP_KEY=CHANGE_ME      # remove after creating named keys

# Scale
QUEUE_MODE=redis
WORKER_CONCURRENCY=8
